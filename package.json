{
  "name": "stillpoint",
  "version": "1.0.10",
  "description": "Activity-aware workspace lock and Argon2id + AES-256-GCM encrypted host-plugin vault for DeepSeek Harness (DSH), with graceful agent draining and email OTP unlock.",
  "license": "MIT",
  "author": "Lubin-Github",
  "homepage": "https://github.com/Lubin-Github/stillpoint#readme",
  "bugs": {
    "url": "https://github.com/Lubin-Github/stillpoint/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lubin-Github/stillpoint.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "stillpoint",
    "workspace-lock",
    "screen-lock",
    "idle-lock",
    "cron-lock",
    "email-otp",
    "two-factor-unlock",
    "argon2id",
    "aes-256-gcm",
    "plugin-vault",
    "security",
    "privacy"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client*.js",
    "gate.js",
    "audit.js",
    "mail.js",
    "managed.js",
    "vault.js",
    "crypto-worker.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "README.en.md",
    "llms.txt"
  ],
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "cron-parser": "5.4.0",
    "nodemailer": "10.6.1",
    "zod": "4.6.7"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
