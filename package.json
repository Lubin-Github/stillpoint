{
  "name": "@local/dsh-lock-gate",
  "version": "1.0.9",
  "description": "Stillpoint adds activity-aware workspace locking and email verification to DeepSeek Harness.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lubin-Github/stillpoint.git"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client*.js",
    "gate.js",
    "audit.js",
    "mail.js",
    "managed.js",
    "vault.js",
    "crypto-worker.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md"
  ],
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "cron-parser": "5.4.0",
    "nodemailer": "10.6.1",
    "zod": "4.6.7"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
